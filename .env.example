# Kopiere diese Datei zu ".env" und trage eure echten Werte ein.
# ".env" selbst wird von Git ignoriert (siehe .gitignore) -- nie committen!

# Discord Bot Token, siehe https://discord.com/developers/applications
DISCORD_TOKEN=

# Channel-IDs (Rechtsklick auf den Channel in Discord -> "ID kopieren",
# braucht aktivierten Entwicklermodus unter Discord-Einstellungen)
POI_CHANNEL_ID=
CHARACTER_CHANNEL_ID=
ECKDATEN_CHANNEL_ID=
FORUM_CHANNEL_ID=

# Optional: Server-ID eintragen, damit Slash-Commands sofort statt erst nach
# bis zu 1h verfügbar sind
# GUILD_ID=

# Dashboard
DASHBOARD_PASSWORD=
SECRET_KEY=
WEB_HOST=0.0.0.0
WEB_PORT=8080
